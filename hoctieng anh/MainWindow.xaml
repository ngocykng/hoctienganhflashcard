<Window x:Class="EnglishFlashcard3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnglishFlashcard3D"
        mc:Ignorable="d"
        Title="English Flashcard 3D" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📚 English Flashcard 3D - Learn English Vocabulary" 
                           Foreground="White" FontSize="24" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="🤖 Sinh Từ Bằng AI" 
                        Background="#0284C7" Foreground="White" FontWeight="Bold"
                        Padding="15,8" Cursor="Hand"
                        Click="OpenGenerateVocabularyWindow"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.Margin>
                <Thickness Left="20" Top="20" Right="20" Bottom="20"/>
            </Grid.Margin>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Decks List -->
            <StackPanel Grid.Column="0">
                <StackPanel.Margin>
                    <Thickness Right="20"/>
                </StackPanel.Margin>
                <TextBlock Text="📖 Bộ Từ Vựng" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                
                <Button Content="🔄 Load Decks" 
                        Command="{Binding LoadDecksCommand}"
                        Background="#0284C7" Foreground="White"
                        Padding="10,8" FontWeight="Bold" Margin="0,0,0,15"
                        Cursor="Hand"/>

                <ListBox ItemsSource="{Binding Decks}" 
                         Background="White" 
                         BorderBrush="#CBD5E1" 
                         BorderThickness="1"
                         Height="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Grid.Row="1" Text="{Binding Cards.Count, StringFormat='📇 {0} cards'}" 
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="▶ Start Study" 
                        Command="{Binding StartStudyCommand}"
                        CommandParameter="{Binding Decks/}"
                        Background="#10B981" Foreground="White"
                        Padding="10,8" FontWeight="Bold" Margin="0,15,0,0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- Right Panel - Flash Card Study -->
            <Border Grid.Column="1" Background="White" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.CornerRadius>
                    <CornerRadius TopLeft="12" TopRight="12" BottomLeft="12" BottomRight="12"/>
                </Border.CornerRadius>
                <Border.Margin>
                    <Thickness/>
                </Border.Margin>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Border Grid.Row="0" Background="#F1F5F9" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tiến độ" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentViewModel.ProgressText}" 
                                       FontWeight="Bold" Foreground="#0284C7" FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Card Content Area - Placeholder for Card3DView -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2">
                        <Border.Margin>
                            <Thickness Left="30" Top="30" Right="30" Bottom="30"/>
                        </Border.Margin>
                        <Border.CornerRadius>
                            <CornerRadius TopLeft="8" TopRight="8" BottomLeft="8" BottomRight="8"/>
                        </Border.CornerRadius>
                        <Grid>
                            <TextBlock Text="Card Display Area" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Control Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.Margin>
                            <Thickness Left="20" Top="20" Right="20" Bottom="20"/>
                        </Grid.Margin>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </StackPanel.Resources>
                            
                            <Button Content="◀ Previous" 
                                    Command="{Binding CurrentViewModel.PrevCommand}"
                                    Background="#64748B" Foreground="White"
                                    Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                            
                            <Button Content="🔄 Flip Card (Space)" 
                                    Command="{Binding CurrentViewModel.FlipCommand}"
                                    Background="#0284C7" Foreground="White"
                                    Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                            
                            <Button Content="Next ▶" 
                                    Command="{Binding CurrentViewModel.NextCommand}"
                                    Background="#64748B" Foreground="White"
                                    Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                            
                            <Button Content="🔊 Pronounce (P)" 
                                    Command="{Binding CurrentViewModel.PronounceCommand}"
                                    Background="#F59E0B" Foreground="White"
                                    Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                            
                            <Button Content="✓ Mastered (M)" 
                                    Command="{Binding CurrentViewModel.MarkMasteredCommand}"
                                    Background="#10B981" Foreground="White"
                                    Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
